{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omafil",
  "version": "0.2.0",
  "identifier": "com.dave.omafil",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../src/",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../src/"
    },
    "frontendDist": "../src/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "omafil",
        "width": 1200,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/media/**", "/mnt/**", "/run/media/**", "/run/user/**", "/usr/share/icons/**", "/usr/local/share/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
